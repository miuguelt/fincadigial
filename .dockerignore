# ════════════════════════════════════════════════════════════════════════
# FINCA VILLA LUZ — .dockerignore (Contexto de Compilación Docker)
# ════════════════════════════════════════════════════════════════════════

# --- Control de Versiones & Metadatos ---
.git/
.gitignore
.dockerignore
.gitattributes
.github/
.devbrain/
.antigravityrules
.codexrules
.cursorrules
.opencoderules
.windsurfrules
.claude/
.gemini/

# --- Secretos, Credenciales y Entornos Locales ---
.env
.env.*
!.env.example
!.env.production.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
secrets.json
credentials.json

# --- Dependencias & Cachés ---
node_modules/
**/node_modules/
.venv/
**/.venv/
venv/
**/venv*/
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.vite/
**/.vite/
*.tsbuildinfo

# --- Salidas de Compilación, Pruebas y Reportes ---
dist/
**/dist/
build/
**/build/
coverage/
**/coverage/
htmlcov/
**/htmlcov/
test-results/
**/test-results/
playwright-report/
**/playwright-report/
tests/
**/tests/
e2e/
**/e2e/
playwright-tests/
**/playwright-tests/
*.log
logs/
**/logs/
*.pid

# --- Documentación, Scripts de Mantenimiento & Datos Locales ---
*.md
docs/
maintenance/
scripts/
scratch/
**/scratch/
_archive/
_graveyard/
backups/
/backups*/
vault/
*.bak
*.bak-*
*_OLD*
*.db
*.sqlite
*.sqlite3
*.sqlite-journal
_data/
mariadb_data/

# --- IDEs & Sistema Operativo ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
