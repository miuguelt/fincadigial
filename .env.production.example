# ════════════════════════════════════════════════════════════════════════
# FINCA VILLA LUZ — Variables de Entorno para Coolify (Producción)
# ════════════════════════════════════════════════════════════════════════
# Solo necesitas configurar estas 5 VARIABLES en la interfaz de Coolify:
# Tu Proyecto -> Tu Recurso (Docker Compose) -> pestaña "Environment Variables"
# ════════════════════════════════════════════════════════════════════════

# ========================================================================
# 🔴 LAS 5 VARIABLES OBLIGATORIAS (Todo lo que necesitas para arrancar)
# ========================================================================

# 1. Tu Dominio Público (sin https:// ni barras):
DOMAIN=villaluz.<TU_DOMINIO_AQUI>.com

# 2. Conexión a Base de Datos PostgreSQL:
# Pega la URL de conexión que Coolify o tu proveedor de base de datos te proporciona:
DATABASE_URL=postgresql://postgres:<CONTRASEÑA_SEGURA_DB>@<HOST_POSTGRES_COOLIFY>:5432/villaluz

# 3. Clave Secreta Criptográfica (64 caracteres hex):
# Generar en tu terminal con: python -c "import secrets; print(secrets.token_hex(32))"
# GENERAR_CLAVE_SEGURA: JWT la hereda automáticamente, no necesitas generar dos claves.
FLASK_SECRET_KEY=<GENERAR_CLAVE_SEGURA_HEX_64_1>

# 4. Correo de tu Administrador Principal (para iniciar sesión):
VILLALUZ_ADMIN_EMAIL=admin@<TU_DOMINIO_AQUI>.com

# 5. Contraseña de tu Administrador Principal:
VILLALUZ_ADMIN_PASSWORD=<CONTRASEÑA_SEGURA_ADMIN>


# ========================================================================
# 🟡 VALORES OPCIONALES (Tienen valores por defecto automáticos)
# ========================================================================
# No necesitas tocarlos a menos que desees personalizar:
#
# VILLALUZ_ADMIN_IDENTIFICATION=1000000001
# VILLALUZ_ADMIN_FULLNAME=Administrador Principal
# VILLALUZ_ADMIN_PHONE=3000000000
# VILLALUZ_ADMIN_FARM_NAME=Finca Villa Luz
# VILLALUZ_ADMIN_FARM_DEPARTMENT=Cundinamarca
# VILLALUZ_ADMIN_FARM_MUNICIPALITY=Bogotá
# REDIS_URL=redis://default:password@redis-host:6379/0
# EMAIL_ENABLED=false
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=notificaciones@tudominio.com
# SENTRY_DSN=
