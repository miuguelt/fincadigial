# ════════════════════════════════════════════════════════════════════════
# FINCA VILLA LUZ — Variables de Entorno para Coolify (Producción)
# ════════════════════════════════════════════════════════════════════════
# Copia estas variables en Coolify:
# Proyecto -> Tu Aplicación (Docker Compose) -> "Environment Variables"
# ════════════════════════════════════════════════════════════════════════

# ========================================================================
# 🔴 1. VARIABLES OBLIGATORIAS (Mínimas requeridas para funcionar)
# ========================================================================

# ── Dominio Público ──
DOMAIN=villaluz.tudominio.com

# ── Base de Datos Externa (PostgreSQL) ──
# (Ingresa los datos de tu PostgreSQL ya desplegado)
DB_HOST=tu-db-host.com
DB_USER=usuario_db
DB_PASSWORD=password_seguro_db
DB_NAME=villaluz
# Alternativa: si tienes una URI única de conexión (ej: Supabase / Neon / Coolify DB):
# DATABASE_URL=postgresql://usuario_db:password_seguro_db@tu-db-host.com:5432/villaluz

# ── Seguridad y Tokens (Generar con: python -c "import secrets; print(secrets.token_hex(32))") ──
FLASK_SECRET_KEY=generar_clave_hex_64_caracteres_1
JWT_SECRET_KEY=generar_clave_hex_64_caracteres_2

# ── Administrador Inicial (Bootstrap) ──
VILLALUZ_ADMIN_IDENTIFICATION=1234567890
VILLALUZ_ADMIN_EMAIL=admin@tudominio.com
VILLALUZ_ADMIN_PASSWORD=TuPasswordAdmin123!


# ========================================================================
# 🟡 2. VARIABLES OPCIONALES (Solo si las requieres)
# ========================================================================

# ── Redis Externo (Opcional - para Celery y Caché) ──
# Si cuentas con un Redis desplegado (ej: redis://usuario:password@host:6379/0):
REDIS_URL=

# ── Notificaciones por Email (SMTP - Opcional) ──
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=

# ── Web Push Notifications PWA & Sentry (Opcional) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=admin@tudominio.com
SENTRY_DSN=
