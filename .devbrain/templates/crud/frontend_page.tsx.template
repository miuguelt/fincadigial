import { useEffect, useState, useCallback } from 'react';
import { AdminCRUDPage } from '@/widgets/admin-crud/ui/AdminCRUDPage';
import { use{{ModelName}} } from './use{{ModelName}}';
import { toast } from 'react-hot-toast';

export default function {{ModelName}}sPage() {
  const { data, loading, error, refetch, createItem, updateItem, deleteItem } = use{{ModelName}}();
  const [page, setPage] = useState(1);
  const [search, setSearch] = useState('');

  useEffect(() => {
    refetch({ page, limit: 20, search }).catch(() => {
      toast.error('Error al cargar datos');
    });
  }, [page, search, refetch]);

  const handleSave = useCallback(async (item: any) => {
    try {
      if (item.id) {
        await updateItem(item.id, item);
        toast.success('Registro actualizado');
      } else {
        await createItem(item);
        toast.success('Registro creado con éxito');
      }
      refetch({ page, limit: 20, search });
    } catch (err: any) {
      toast.error(err?.response?.data?.message || err?.message || 'Error al guardar');
    }
  }, [page, search, createItem, updateItem, refetch]);

  const handleDelete = useCallback(async (id: number | string) => {
    try {
      await deleteItem(id);
      toast.success('Registro eliminado');
      refetch({ page, limit: 20, search });
    } catch (err: any) {
      toast.error(err?.response?.data?.message || 'No se pudo eliminar');
    }
  }, [page, search, deleteItem, refetch]);

  return (
    <div className="w-full h-full max-w-full overflow-hidden">
      <AdminCRUDPage
        title="Gestión de {{ModelName}}s"
        data={data}
        page={page}
        pageSize={20}
        onPageChange={setPage}
        onSearch={setSearch}
        isLoading={loading}
        columns={[
          { key: 'name', title: 'Nombre', type: 'text', required: true },
          { key: 'description', title: 'Descripción', type: 'textarea' },
        ]}
        onSave={handleSave}
        onDelete={handleDelete}
      />
    </div>
  );
}
