# Generated module baseline: keep frontend-only rules here; shared rules live at ../.gitignore.

# --- Local configuration and private material ---
.env
.env.*
!.env.example
!.env.*.example
!.env.*.template
certificates/
*.pem
*.key
*.p12
*.pfx

# --- Node dependencies and caches ---
node_modules/
.npm/
.pnpm-store/
.yarn/
.pnp.*
.cache/
.vite/
*.tsbuildinfo
*.eslintcache

# --- Build and test output ---
dist/
build/
dev-dist/
coverage/
test-results/
playwright-report/
.nyc_output/
*.lcov
*.lcov-report/

# --- Logs and local runtime state ---
*.log
logs/
*.pid
*.seed
*.pid.lock
opencodetmp/

# --- Frontend-only test tooling not needed in production builds ---
e2e/.auth/
playwright/.auth/

# --- Local IDE and operating-system files ---
.vscode/
.idea/
.claude/
*.swp
*.swo
.DS_Store
Thumbs.db
