# Generated migration versions are recreated by the migration tool; retain manual indexes.
/migrations/versions/*
!/migrations/versions/perf001_runtime_query_indexes.py
!/migrations/versions/perf002_calendar_alert_indexes.py
/migrations/__pycache__/

