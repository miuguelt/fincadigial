# Generated module baseline: keep backend-only rules here; shared rules live at ../.gitignore.

# --- Local secrets and certificates ---
.env
.env.*
!.env.example
!.env.*.example
!.env.*.template
/.dev_jwt_secret
/certs/
*.pem
*.key
*.p12
*.pfx

# --- Python local state ---
__pycache__/
*.py[cod]
.venv/
venv/
venv_win/
venv_wsl/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
*.egg-info/
build/
dist/

# --- Backend runtime state ---
/instance/
/instance/scripts/
*.db
*.sqlite
*.sqlite3
*.log
/logs/
/backups/
/artifacts/
/scratch/
static/uploads/

# --- Generated/legacy backend folders ---
/sdk/
/tools/
/scripts/
finca (6).sql
routes.json
run.py

# Migrations are versioned in full: the Alembic tree must be complete in git or
# any clean build/deploy (fresh or empty DB) fails with KeyError on a missing
# down_revision. The tree converges via merge migrations.
/migrations/__pycache__/

# --- Local IDE state ---
.idea/
.vscode/
.claude/
*.swp
*.swo
